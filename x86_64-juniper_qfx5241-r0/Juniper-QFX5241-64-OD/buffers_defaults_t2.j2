{%- macro generate_pg_profils(port_names_active) %}
    "BUFFER_PG": {
{%- set ports = port_names_active.split(',') %}
{%- for port in ports %}
{%- if PORT is defined and port in PORT and 'speed' in PORT[port] %}
{%- set speed = PORT[port]['speed'] %}
{%- else %}
{%- set speed = '800000' %}
{%- endif %}
        "{{ port }}|0": {
            "profile": "ingress_lossy_profile"
        },
        "{{ port }}|3-4": {
            "profile": "pg_lossless_{{ speed }}_5m_profile"
        }{% if not loop.last %},{% endif %}

{%- endfor %}
    },
{%- endmacro %}
